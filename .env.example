# Copy to .env and fill in. NEVER commit the real .env file.

# Free key from https://console.groq.com  (without it, every upload safely goes to human review)
GROQ_API_KEY=

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Security alerts (optional). Slack: create an Incoming Webhook; Teams: use a Workflows webhook.
# The URL is a SECRET. Never commit it or paste it anywhere public.
ALERT_WEBHOOK_URL=
ALERT_FORMAT=slack          # slack | teams | generic
ALERT_WEBHOOK_SECRET=       # optional: signs payloads (X-VendorGuard-Signature)
APP_BASE_URL=http://localhost:3000

# Docker only
POSTGRES_PASSWORD=

# Fake demo data + one-click demo logins (portfolio site only, never with real data)
SEED_DEMO=true
NEXT_PUBLIC_DEMO_MODE=true

# Local Docker: development / false.   Deployed over HTTPS: production / true.
APP_ENV=development
COOKIE_SECURE=false
